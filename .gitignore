# Raw ingest dumps (yt-dlp captions, fetched HTML, source PDFs/EPUBs) — large,
# regenerable from each library's sources/manifest.json. The cleaned text in
# each library's sources/clean/ is the provenance record.
libraries/*/sources/raw/

# Purchased/downloaded source books (PDF, EPUB, etc.) staged for add_pdf.py /
# add_epub.py before ingestion. Never committed — these are often copyrighted
# works the user owns a personal copy of; only the cited, paraphrased note
# and the library's own clean/manifest provenance record belong in git.
/ebook/

# macOS
.DS_Store

# Python
__pycache__/
*.pyc
.venv/
venv/

# Xcode
ios/build/
ios/**/xcuserdata/
*.xcuserstate

# Transient fetch batch, rewritten by add_videos.py on every run.
libraries/*/ingest_state/video_ids_added.txt
